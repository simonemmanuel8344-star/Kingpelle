rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    function isSignedIn() { 
      return request.auth != null; 
    }
    
    function isAdmin() { 
      return isSignedIn() && 
             (request.auth.token.email.lower() == 'simonemmanuel8344@gmail.com' ||
              request.auth.token.email == 'simonemmanuel8344@gmail.com'); 
    }
    
    function incoming() { 
      return request.resource.data; 
    }
    
    function isValidString(val, maxLen) {
      return val is string && val.size() <= maxLen;
    }
    
    function isValidOptionalString(val, maxLen) {
      return val == null || (val is string && val.size() <= maxLen);
    }
    
    function isValidApplication(data) {
      return data.keys().hasAll(['jobId', 'fullName', 'phone', 'appliedAt']) &&
             isValidString(data.jobId, 128) &&
             isValidString(data.fullName, 150) &&
             isValidString(data.phone, 50) &&
             isValidOptionalString(data.get('id', null), 128) &&
             isValidOptionalString(data.get('jobTitle', null), 200) &&
             isValidOptionalString(data.get('cvUrl', null), 800000) &&
             isValidOptionalString(data.get('cvName', null), 200) &&
             isValidOptionalString(data.get('cvLink', null), 1000) &&
             isValidOptionalString(data.get('photoUrl', null), 300000) &&
             isValidOptionalString(data.get('resumeText', null), 10000) &&
             isValidOptionalString(data.get('status', null), 50);
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }
    
    match /chats/{chatId} {
      allow read: if isSignedIn() && (resource == null || (resource.data.participants is list && request.auth.uid in resource.data.participants) || isAdmin());
      allow create: if isSignedIn() && (request.resource.data.participants is list && request.auth.uid in request.resource.data.participants || isAdmin());
      allow update: if isSignedIn() && (resource.data.participants is list && request.auth.uid in resource.data.participants || isAdmin());
      allow delete: if isAdmin();
      
      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.auth.uid == request.resource.data.senderId;
        allow update, delete: if isAdmin();
      }
    }

    match /professionals/{profId} {
      allow read: if true;
      allow write: if isAdmin() || (isSignedIn() && request.auth.uid == profId);
    }

    match /ratings/{ratingId} {
      allow read: if true;
      allow create: if isSignedIn() && request.auth.uid == incoming().userId && incoming().rating >= 1 && incoming().rating <= 5;
      allow update: if isSignedIn() && request.auth.uid == resource.data.userId && incoming().rating >= 1 && incoming().rating <= 5;
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.userId);
    }

    match /projects/{projId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /jobs/{jobId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /applications/{appId} {
      allow create: if isValidApplication(incoming());
      allow read, update, delete: if isAdmin();
    }

    match /settings/global {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}

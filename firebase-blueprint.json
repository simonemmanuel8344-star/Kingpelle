{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile for registered clients, professionals, and administrators",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "fullName": { "type": "string" },
        "role": { "type": "string", "enum": ["client", "admin", "professional"] },
        "phone": { "type": "string" },
        "jobCategory": { "type": "string" },
        "skills": { "type": "array" },
        "picture": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "email", "fullName", "role", "createdAt"]
    },
    "ChatSession": {
      "title": "ChatSession",
      "description": "A conversation thread between a client and a professional",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "clientId": { "type": "string" },
        "clientName": { "type": "string" },
        "professionalId": { "type": "string" },
        "professionalName": { "type": "string" },
        "professionalPicture": { "type": "string" },
        "lastMessage": { "type": "string" },
        "updatedAt": { "type": "string" },
        "participants": { "type": "array" }
      },
      "required": ["id", "clientId", "professionalId", "participants", "updatedAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "A single message in a chat conversation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "chatId": { "type": "string" },
        "senderId": { "type": "string" },
        "text": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["chatId", "senderId", "text", "timestamp"]
    },
    "Professional": {
      "title": "Professional",
      "description": "Vetted talent and service provider profile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fullName": { "type": "string" },
        "picture": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "jobCategory": { "type": "string" },
        "skills": { "type": "array" },
        "bio": { "type": "string" },
        "location": { "type": "string" },
        "yearsOfExperience": { "type": "string" },
        "portfolioItems": { "type": "array" },
        "rating": { "type": "number" },
        "ratingCount": { "type": "number" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "fullName", "phone", "email", "jobCategory"]
    },
    "Rating": {
      "title": "Rating",
      "description": "Client rating and review for a professional",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "profId": { "type": "string" },
        "profName": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "profId", "userId", "userName", "rating", "createdAt"]
    },
    "Project": {
      "title": "Project",
      "description": "Portfolio work showcase item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "imageUrl": { "type": "string" },
        "category": { "type": "string" }
      },
      "required": ["id", "title", "imageUrl", "category"]
    },
    "Job": {
      "title": "Job",
      "description": "Job vacancy posting",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "company": { "type": "string" },
        "jobType": { "type": "string" },
        "logoUrl": { "type": "string" }
      },
      "required": ["id", "title", "description", "company"]
    },
    "JobApplication": {
      "title": "JobApplication",
      "description": "Candidate application for a posted job",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "jobId": { "type": "string" },
        "jobTitle": { "type": "string" },
        "fullName": { "type": "string" },
        "phone": { "type": "string" },
        "cvUrl": { "type": "string" },
        "cvName": { "type": "string" },
        "cvLink": { "type": "string" },
        "photoUrl": { "type": "string" },
        "resumeText": { "type": "string" },
        "appliedAt": { "type": "string" }
      },
      "required": ["id", "jobId", "fullName", "phone", "appliedAt"]
    },
    "GlobalSettings": {
      "title": "GlobalSettings",
      "description": "App branding, hero configuration, and invite codes",
      "type": "object",
      "properties": {
        "logoUrl": { "type": "string" },
        "heroImageUrl": { "type": "string" },
        "professionalInviteCode": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile records"
    },
    "/chats/{chatId}": {
      "schema": "ChatSession",
      "description": "Chat conversations"
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Messages inside a chat conversation"
    },
    "/professionals/{profId}": {
      "schema": "Professional",
      "description": "List of vetted professionals"
    },
    "/ratings/{ratingId}": {
      "schema": "Rating",
      "description": "Client ratings and reviews for professionals"
    },
    "/projects/{projId}": {
      "schema": "Project",
      "description": "Portfolio projects"
    },
    "/jobs/{jobId}": {
      "schema": "Job",
      "description": "Job listings"
    },
    "/applications/{appId}": {
      "schema": "JobApplication",
      "description": "Submitted job applications"
    },
    "/settings/global": {
      "schema": "GlobalSettings",
      "description": "App settings"
    }
  }
}
